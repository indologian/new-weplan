# =========================================================

# APP

# =========================================================

# Local:

# http://localhost:3000

#

# Production:

# https://weplan.id

NEXT_PUBLIC_APP_URL=

# =========================================================

# SUPABASE - PUBLIC

# Aman digunakan di browser

# =========================================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# =========================================================

# SUPABASE - SERVER ONLY

# JANGAN tambahkan prefix NEXT_PUBLIC_

# =========================================================

SUPABASE_SECRET_KEY=

# =========================================================

# MIDTRANS

# =========================================================

# Client key digunakan oleh Midtrans Snap di browser

NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=

# Server key hanya boleh digunakan server-side

MIDTRANS_SERVER_KEY=

# Development / Sandbox:

# false

#

# Production:

# true

MIDTRANS_IS_PRODUCTION=false

# =========================================================

# INVITEE TOKEN ENCRYPTION

# SERVER ONLY

# =========================================================

# Digunakan untuk AES-GCM encryption token invitee

# yang perlu dapat dipulihkan server-side untuk fitur Copy Link.

#

# Jangan commit nilai sebenarnya.

INVITEE_TOKEN_ENCRYPTION_KEY=

# =========================================================

# CRON / INTERNAL JOB

# SERVER ONLY

# =========================================================

# Melindungi internal lifecycle/cleanup endpoint.

CRON_SECRET=
